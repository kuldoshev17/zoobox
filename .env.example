# --- Telegram bot ---
BOT_TOKEN=your_telegram_bot_token_from_botfather
API_BASE_URL=http://127.0.0.1:8000

# --- Database ---
# Hosted PostgreSQL for production; leave unset for local SQLite development.
# Example: postgresql+psycopg://user:password@host:5432/zoopet
DATABASE_URL=

# --- Telegram Mini App (butun do'kon shu yerda ishlaydi — web/index.html) ---
# Ochiq HTTPS manzil bo'lishi shart (Telegram talabi). Lokal test uchun ngrok
# ishlatish mumkin: ngrok http 8000, so'ng chiqqan https:// manzilni shu yerga qo'ying.
# Bo'sh qoldirilsa, bot /start buyrug'ida hech qanday amalga oshiriladigan tugma ko'rsata olmaydi
# (endi matnli menyu fallback yo'q — do'kon faqat Mini App orqali ishlaydi).
MINIAPP_URL=

# --- Cloudinary product images (production) ---
# If these are empty, local development stores images in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mijoz sessiya tokenlari (JWT) ---
# python -c "import secrets; print(secrets.token_hex(32))" bilan bir marta yarating.
# Maxfiy saqlang — buni almashtirsangiz barcha mijozlar qayta avtorizatsiyadan o'tadi
# (initData orqali avtomatik, mijoz uchun sezilarli emas).
JWT_SECRET=

# --- Admin bildirishnomalari (yangi buyurtma kelganda xabar boradigan chat_id lar) ---
# Bir nechta bo'lsa vergul bilan ajrating: 111111,222222
ADMIN_CHAT_ID=

# --- CLICK to'lov tizimi (https://merchant.click.uz) ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# --- PAYME to'lov tizimi (https://business.payme.uz) ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
